# ── Telegram ──
# Token from @BotFather (Business Mode must be enabled for the bot)
TELEGRAM_BOT_TOKEN=
# Telegram user ID(s) that receive lead cards and may use admin commands / mini app (comma separated)
TELEGRAM_ADMIN_ID=
# Optional extra admins
ADMIN_IDS=
# TEMUR's own Telegram user ID (the business account). Also used to recognise him in chat exports.
TEMUR_TELEGRAM_ID=

# ── Database ──
MONGODB_URI=mongodb://127.0.0.1:27017/temur_fit

# ── LLM (Google Gemini) ──
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_TIMEOUT_MS=30000
LLM_MAX_CONCURRENCY=4

# ── Server ──
PORT=3000
# Public https URL of this service (mini app + webhook). On Railway RAILWAY_PUBLIC_DOMAIN is used automatically.
PUBLIC_URL=
# polling (default, simplest) or webhook (needs PUBLIC_URL)
BOT_MODE=polling
# Random string; Telegram sends it with every webhook call
WEBHOOK_SECRET=
# Optional: open the mini app in a normal browser with ?token=... (leave empty to allow Telegram only)
ADMIN_WEB_TOKEN=

TZ_NAME=Asia/Tashkent
LOG_LEVEL=info
NODE_ENV=production
