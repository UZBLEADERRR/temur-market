{
  "name": "temur-fit-lead-bot",
  "version": "1.0.0",
  "private": true,
  "description": "TEMUR.FIT Telegram Business AI lead qualification assistant",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-public.js",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "import:chats": "tsx src/scripts/importChats.ts",
    "style:build": "tsx src/scripts/buildStyle.ts",
    "simulate": "tsx src/scripts/simulate.ts"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "dotenv": "^18.0.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "grammy": "^1.46.0",
    "mongoose": "^9.10.3",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
